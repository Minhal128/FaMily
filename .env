# Where family-backend is listening. Not a secret — EXPO_PUBLIC_ vars are inlined
# into the bundle. Use your machine's LAN IP, not localhost: a phone or emulator
# resolves localhost to itself.
#   Android emulator: http://10.0.2.2:4000
#   iOS simulator / web: http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=http://192.168.1.2:4000
